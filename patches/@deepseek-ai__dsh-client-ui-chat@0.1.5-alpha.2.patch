index 0000000000000000000000000000000000000000..21d8aeb62e5af59cb650ce214c93c657681b5e36
--- /dev/null
+++ b/lib/types/client/chat-navigation.d.ts
@@ -0,0 +1,11 @@
+import type { SessionId } from '@deepseek-ai/dsh-session/types';
+/** Presentation-only Chat navigation; callers retain official Session authorization and opening. */
+export interface IChatNavigation {
+    /** Request the exact Session's next open Chat view to show latest content once. Returns cancellation; superseded cancellation is harmless. */
+    requestLatest(sessionId: SessionId, options?: { readonly signal?: AbortSignal }): () => void;
+}
+declare module '@deepseek-ai/cordis' {
+    interface Context {
+        chatNavigation: IChatNavigation;
+    }
+}
