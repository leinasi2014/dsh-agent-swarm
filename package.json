{
  "name": "dsh-agent-swarm",
  "version": "0.1.0",
  "private": true,
  "description": "Durable multi-agent Team orchestration, review, budgets, memory, and scheduling for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.mjs",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.mjs"
    },
    "./client": {
      "types": "./lib/types/client/plugin-entry.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "docs",
    ".agents/skills"
  ],
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "build": "pnpm clean && tsc -p tsconfig.json && tsdown",
    "lint": "oxlint .",
    "verify:duplication": "jscpd src",
    "verify:exports": "knip",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify:scenarios": "node scripts/verify-test-scenarios.mjs",
    "verify:workspace": "node scripts/verify-workspace-boundary.mjs && node scripts/test-workspace-boundary-gate.mjs",
    "verify:official": "node scripts/verify-official-baseline.mjs",
    "verify:references": "node scripts/verify-reference-baselines.mjs",
    "verify:anchors": "node scripts/verify-doc-anchors.mjs",
    "p0:profile-proof": "node scripts/p0/run.mjs",
    "verify:p0-evidence": "node scripts/verify-p0-profile-proof.mjs",
    "verify:p0-fixtures": "node scripts/test-p0-profile-proof-gate.mjs",
    "verify:governance": "node scripts/verify-governance.mjs && node scripts/test-governance-gate.mjs",
    "verify:knowledge-graph:bootstrap": "node scripts/test-knowledge-graph-gate.mjs",
    "verify:knowledge-graph:extractor": "node scripts/test-knowledge-graph-extractor.mjs",
    "verify:knowledge-graph:reconcile": "node scripts/test-knowledge-graph-reconcile.mjs && node scripts/knowledge-graph/reconcile-source.mjs",
    "verify:worktrees": "node scripts/verify-worktree-layout.mjs && node scripts/test-worktree-layout-gate.mjs",
    "verify:gate-a": "pnpm verify:workspace && pnpm verify:official && pnpm verify:references",
    "verify:structure": "node scripts/verify-project.mjs",
    "verify:artifact": "node scripts/test-package-artifact-policy.mjs && node scripts/verify-package-artifact.mjs",
    "verify": "pnpm verify:governance && pnpm verify:workspace && pnpm verify:worktrees && pnpm verify:structure && pnpm verify:p0-fixtures && pnpm lint && pnpm verify:duplication && pnpm verify:exports && pnpm typecheck && pnpm typecheck:test && pnpm test && pnpm verify:scenarios && pnpm build && pnpm verify:artifact"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-jobs": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session-persistence": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-skill": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-subagent": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-user-questions": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-workflow": "^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-user-questions": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-agent-loop": "0.1.1-rc.2",
    "@deepseek-ai/dsh-agent-loop-testkit": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "0.1.1-rc.2",
    "@deepseek-ai/dsh-jobs": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session-persistence-sqlite": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.1-rc.2",
    "@deepseek-ai/dsh-skill": "0.1.1-rc.2",
    "@deepseek-ai/dsh-storage": "0.1.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.1.1-rc.2",
    "@deepseek-ai/dsh-storage-json": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subagent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subagent-spawn-in-process": "0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.1-rc.2",
    "@deepseek-ai/dsh-token-meter": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tool-subagent-report": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.1.1-rc.2",
    "@deepseek-ai/dsh-user-questions": "0.1.1-rc.2",
    "@deepseek-ai/dsh-workflow": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/jsdom": "30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@vitest/coverage-v8": "^3.2.4",
    "ajv": "8.20.0",
    "canonicalize": "4.0.0",
    "jscpd": "^5.0.16",
    "jsdom": "30.0.1",
    "knip": "^6.32.2",
    "lefthook": "^2.1.10",
    "oxlint": "^1.79.0",
    "playwright": "1.61.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
