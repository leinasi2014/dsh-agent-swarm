{
  "name": "dsh-agent-swarm",
  "version": "0.1.1",
  "private": true,
  "description": "Durable multi-agent Team orchestration, review, budgets, memory, and scheduling for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.mjs",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.mjs"
    },
    "./client": {
      "types": "./lib/types/client/plugin-entry.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "docs",
    ".agents/skills"
  ],
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "hooks:install": "lefthook install",
    "build": "pnpm clean && tsc -p tsconfig.json && tsdown",
    "lint": "oxlint .",
    "verify:duplication": "jscpd src",
    "verify:exports": "knip",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:agile-hook": "node scripts/test-agile-hook.mjs",
    "test:coverage": "vitest run --coverage",
    "verify:scenarios:gate": "node scripts/test-verify-test-scenarios-gate.mjs",
    "verify:scenarios": "pnpm verify:scenarios:gate && node scripts/verify-test-scenarios.mjs",
    "verify:workspace": "node scripts/verify-workspace-boundary.mjs && node scripts/test-workspace-boundary-gate.mjs",
    "verify:official": "node scripts/verify-official-baseline.mjs",
    "verify:references": "node scripts/test-reference-baselines-gate.mjs && node scripts/verify-reference-baselines.mjs",
    "verify:anchors": "node scripts/verify-doc-anchors.mjs",
    "p0:profile-proof": "node scripts/p0/run.mjs",
    "verify:p0-evidence": "node scripts/verify-p0-profile-proof.mjs",
    "verify:p0-fixtures": "node scripts/test-p0-profile-proof-gate.mjs",
    "verify:policy": "node scripts/verify-governance.mjs && node scripts/test-governance-gate.mjs && pnpm verify:scenarios:gate",
    "verify:policy:declared": "node scripts/verify-governance.mjs --skip-git && node scripts/test-governance-gate.mjs && pnpm verify:scenarios:gate",
    "verify:governance": "pnpm verify:policy",
    "isolation": "node scripts/worktree-lifecycle.mjs",
    "verify:isolation:lifecycle": "node scripts/test-worktree-lifecycle-gate.mjs",
    "verify:isolation": "node scripts/verify-worktree-layout.mjs && node scripts/test-worktree-layout-gate.mjs && pnpm verify:isolation:lifecycle",
    "verify:isolation:status": "node scripts/verify-isolation-status.mjs",
    "verify:worktrees": "pnpm verify:isolation",
    "verify:compatibility": "pnpm verify:official && pnpm verify:references",
    "verify:gate-a": "pnpm verify:compatibility",
    "verify:structure": "node scripts/verify-project.mjs && node scripts/test-verify-project-gate.mjs",
    "verify:artifact": "node scripts/verify-package-artifact.mjs",
    "verify:package-install": "node scripts/verify-package-install.mjs",
    "verify:engineering": "pnpm verify:structure && pnpm verify:workspace && pnpm verify:p0-fixtures && pnpm lint && pnpm verify:duplication && pnpm verify:exports && pnpm typecheck && pnpm typecheck:test && pnpm test && pnpm verify:scenarios && pnpm build && pnpm verify:artifact && pnpm verify:package-install",
    "verify:candidate": "pnpm verify:engineering && pnpm verify:p0-evidence --candidate",
    "verify": "pnpm verify:candidate"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
