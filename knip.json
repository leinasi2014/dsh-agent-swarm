{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs", "scripts/promotion/*.mjs", "tests/**/*.spec.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.mjs", "tests/**/*.ts"]
    },
    "packages/panel": {
      "entry": ["tests/**/*.spec.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}", "tests/**/*.{ts,tsx}"]
    }
  }
}
