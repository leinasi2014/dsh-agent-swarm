# Editor guidance mirroring the enforced checks in scripts/verify-project.mjs
# (UTF-8, final newline) plus the normalized LF ending from .gitattributes.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.ps1]
end_of_line = crlf

[*.{cmd,bat}]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false
